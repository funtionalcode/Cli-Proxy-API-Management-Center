FROM node:22-alpine AS web-build
ARG VERSION=dev
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG all_proxy
ARG no_proxy
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate && pnpm install --frozen-lockfile --ignore-scripts
COPY . .
RUN VERSION=$VERSION pnpm run build

FROM golang:1.24-alpine AS service-build
ARG TARGETOS
ARG TARGETARCH
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG all_proxy
ARG no_proxy
ARG GOPROXY=https://proxy.golang.org,direct
WORKDIR /src
COPY usage-service ./usage-service
COPY --from=web-build /app/dist/management.html ./usage-service/internal/httpapi/web/management.html
WORKDIR /src/usage-service
RUN GOPROXY=$GOPROXY go mod download
RUN GOPROXY=$GOPROXY CGO_ENABLED=0 GOOS=${TARGETOS:-$(go env GOOS)} GOARCH=${TARGETARCH:-$(go env GOARCH)} go build -o /out/cpa-manager ./cmd/cpa-manager

FROM alpine:3.21
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG all_proxy
ARG no_proxy
RUN apk add --no-cache ca-certificates wget
WORKDIR /app
COPY --from=service-build /out/cpa-manager /usr/local/bin/cpa-manager
ENV HTTP_ADDR=0.0.0.0:18317
ENV USAGE_DATA_DIR=/data
ENV USAGE_DB_PATH=/data/usage.sqlite
EXPOSE 18317
ENTRYPOINT ["cpa-manager"]
